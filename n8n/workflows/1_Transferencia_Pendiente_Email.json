      "name": "Gmail (Enviar OAuth2)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [ 500, 300 ]
    }
  ],
  "connections": {
    "Webhook Checkout": { "main": [ [ { "node": "Gmail (Enviar OAuth2)", "type": "main", "index": 0 } ] ] }
